# Client-visible. Safe by design. Values are placeholders — never commit real keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx

# Server-only. Must never appear in a Client Component or a NEXT_PUBLIC_ var.
CLERK_SECRET_KEY=sk_test_xxx

# Route config
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/post-auth
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/post-auth

# Orchestration API. Server-only. Production points at the real orchestrator.
# Local dev points at the throwaway stub:
#   ORCHESTRATION_API_URL=http://localhost:3000/api/dev/orchestration
ORCHESTRATION_API_URL=http://localhost:4000

# Only if webhook backfill is implemented (out of scope for FE-B01)
# CLERK_WEBHOOK_SIGNING_SECRET=whsec_xxx
