FROM python:3.12-slim AS base
RUN pip install uv

FROM base AS runner
WORKDIR /app
COPY pyproject.toml uv.lock ./
COPY agent/ ./agent/
COPY mcp/pyproject.toml ./mcp/pyproject.toml
COPY packages/manifest-contracts/ ./packages/manifest-contracts/
RUN uv sync --frozen --no-dev --package provisr-agent
EXPOSE 5000
CMD ["uv", "run", "--frozen", "--no-dev", "--package", "provisr-agent", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "5000"]
