        },
        "instance_type": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Instance Type",
          "type": "string"
        },
        "image": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Image",
          "type": "string"
        },
        "count": {
          "default": 1,
          "maximum": 20,
          "minimum": 1,
          "title": "Count",
          "type": "integer"
        }
