      "type": "string"
    },
    "environment": {
      "enum": [
        "development",
        "staging",
        "production",
        "sandbox"
      ],
      "title": "Environment",
      "type": "string"
    },
    "monthly_budget_usd": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Monthly Budget Usd"
    },
    "tags": {
