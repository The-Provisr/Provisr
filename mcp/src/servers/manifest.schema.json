        "name": {
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$",
          "title": "Name",
          "type": "string"
        },
        "resource_ref": {
          "pattern": "^(manifest:[a-zA-Z0-9_.-]{1,512}|//[a-z][a-z0-9.]+\\.googleapis\\.com/projects/[a-z][a-z0-9-]{4,28}[a-z0-9]/[^\\s]+)$",
          "title": "Resource Ref",
          "type": "string"
        },
        "metric_name": {
          "pattern": "^[a-z][a-z0-9.]+\\.googleapis\\.com/[a-zA-Z0-9_/]+$",
