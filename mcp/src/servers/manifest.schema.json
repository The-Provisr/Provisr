      ],
      "title": "BackupConfiguration",
      "type": "object"
    },
    "Ec2Resource": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "aws_ec2",
          "title": "Type",
          "type": "string"
        },
