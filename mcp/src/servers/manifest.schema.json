          "title": "Name",
          "type": "string"
        },
        "metric_ref": {
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$",
          "title": "Metric Ref",
          "type": "string"
        },
        "threshold": {
          "title": "Threshold",
          "type": "number"
        },
        "comparison": {
          "enum": [
            "greater_than",
