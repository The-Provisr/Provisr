          "maxItems": 16,
          "minItems": 1,
          "title": "Notification Target Refs",
          "type": "array"
        }
      },
      "required": [
        "name",
        "metric_ref",
        "threshold",
        "comparison",
        "missing_data",
        "type",
        "project_id",
        "duration_seconds",
        "trigger_count",
        "notification_target_refs"
      ],
      "title": "GcpAlarm",
      "type": "object"
    },
