{
  "$defs": {
    "AwsAlarm": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[^\\x00-\\x1f]+$",
          "title": "Name",
          "type": "string"
        },
        "metric_ref": {
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$",
          "title": "Metric Ref",
          "type": "string"
        },
        "threshold": {
          "title": "Threshold",
          "type": "number"
        },
        "comparison": {
          "enum": [
            "greater_than",
            "greater_than_or_equal",
            "less_than",
            "less_than_or_equal"
          ],
          "title": "Comparison",
          "type": "string"
        },
        "missing_data": {
          "enum": [
            "breaching",
            "not_breaching",
            "ignore",
            "missing"
          ],
          "title": "Missing Data",
          "type": "string"
        },
        "type": {
          "const": "aws_cloudwatch_alarm",
          "title": "Type",
          "type": "string"
        },
        "period_seconds": {
          "maximum": 86400,
          "minimum": 10,
          "title": "Period Seconds",
          "type": "integer"
        },
        "evaluation_periods": {
          "minimum": 1,
          "title": "Evaluation Periods",
          "type": "integer"
        },
        "datapoints_to_alarm": {
          "minimum": 1,
          "title": "Datapoints To Alarm",
          "type": "integer"
        },
        "notification_target_refs": {
          "items": {
            "pattern": "^arn:aws(-us-gov|-cn)?:sns:[a-z0-9-]+:[0-9]{12}:[a-zA-Z0-9_-]{1,256}(\\.fifo)?$",
            "type": "string"
          },
          "maxItems": 5,
          "minItems": 1,
          "title": "Notification Target Refs",
          "type": "array"
        }
      },
      "required": [
        "name",
        "metric_ref",
        "threshold",
        "comparison",
        "missing_data",
        "type",
        "period_seconds",
        "evaluation_periods",
        "datapoints_to_alarm",
        "notification_target_refs"
      ],
      "title": "AwsAlarm",
      "type": "object"
    },
    "AwsLogGroup": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 512,
          "minLength": 1,
          "pattern": "^[.\\-_/#a-zA-Z0-9]+$",
          "title": "Name",
          "type": "string"
        },
        "resource_refs": {
          "items": {
            "pattern": "^(manifest:[a-zA-Z0-9_.-]{1,512}|arn:aws(-us-gov|-cn)?:[a-z0-9-]+:[a-z0-9-]*:[0-9]{12}:[^\\s]+|arn:aws(-us-gov|-cn)?:s3:::[a-z0-9][a-z0-9.-]{1,61}[a-z0-9])$",
            "type": "string"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Resource Refs",
          "type": "array"
        },
        "type": {
          "const": "aws_cloudwatch_log_group",
          "title": "Type",
          "type": "string"
        },
        "retention_days": {
          "anyOf": [
            {
              "enum": [
                1,
                3,
                5,
                7,
                14,
                30,
                60,
                90,
                120,
                150,
                180,
                365,
                400,
                545,
                731,
                1096,
                1827,
                2192,
                2557,
                2922,
                3288,
                3653
              ],
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Retention Days"
        }
      },
      "required": [
        "name",
        "resource_refs",
        "type",
        "retention_days"
      ],
      "title": "AwsLogGroup",
      "type": "object"
    },
    "AwsMetric": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$",
          "title": "Name",
          "type": "string"
        },
        "resource_ref": {
          "pattern": "^(manifest:[a-zA-Z0-9_.-]{1,512}|arn:aws(-us-gov|-cn)?:[a-z0-9-]+:[a-z0-9-]*:[0-9]{12}:[^\\s]+|arn:aws(-us-gov|-cn)?:s3:::[a-z0-9][a-z0-9.-]{1,61}[a-z0-9])$",
          "title": "Resource Ref",
          "type": "string"
        },
        "metric_name": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[^\\x00-\\x1f]+$",
          "title": "Metric Name",
          "type": "string"
        },
        "type": {
          "const": "aws_cloudwatch_metric",
          "title": "Type",
          "type": "string"
        },
        "namespace": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[^:\\x00-\\x1f]+$",
          "title": "Namespace",
          "type": "string"
        },
        "dimensions": {
          "additionalProperties": {
            "type": "string"
          },
          "maxProperties": 30,
          "minProperties": 1,
          "title": "Dimensions",
          "type": "object"
        },
        "statistic": {
          "enum": [
            "Average",
            "Sum",
            "Minimum",
            "Maximum",
            "SampleCount"
          ],
          "title": "Statistic",
          "type": "string"
        },
        "storage_resolution_seconds": {
          "enum": [
            1,
            60
          ],
          "title": "Storage Resolution Seconds",
          "type": "integer"
        }
      },
      "required": [
        "name",
        "resource_ref",
        "metric_name",
        "type",
        "namespace",
        "dimensions",
        "statistic",
        "storage_resolution_seconds"
      ],
      "title": "AwsMetric",
      "type": "object"
    },
    "AzureAlarm": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 260,
          "minLength": 1,
          "pattern": "^[^\\s*#&+:<>?%{}\\\\/]+$",
          "title": "Name",
          "type": "string"
        },
        "metric_ref": {
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$",
          "title": "Metric Ref",
          "type": "string"
        },
        "threshold": {
          "title": "Threshold",
          "type": "number"
        },
        "comparison": {
          "enum": [
            "greater_than",
            "greater_than_or_equal",
            "less_than",
            "less_than_or_equal"
          ],
          "title": "Comparison",
          "type": "string"
        },
        "missing_data": {
          "const": "ignore",
          "title": "Missing Data",
          "type": "string"
        },
        "type": {
          "const": "azure_monitor_alarm",
          "title": "Type",
          "type": "string"
        },
        "window_seconds": {
          "enum": [
            60,
            300,
            900,
            1800,
            3600,
            21600,
            43200,
            86400
          ],
          "title": "Window Seconds",
          "type": "integer"
        },
        "evaluation_frequency_seconds": {
          "enum": [
            60,
            300,
            900,
            1800,
            3600
          ],
          "title": "Evaluation Frequency Seconds",
          "type": "integer"
        },
        "severity": {
          "maximum": 4,
          "minimum": 0,
          "title": "Severity",
          "type": "integer"
        },
        "notification_target_refs": {
          "items": {
            "pattern": "^/subscriptions/[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}/resourceGroups/[^/\\s]+/providers/Microsoft\\.Insights/actionGroups/[^/\\s]+$",
            "type": "string"
          },
          "maxItems": 5,
          "minItems": 1,
          "title": "Notification Target Refs",
          "type": "array"
        }
      },
      "required": [
        "name",
        "metric_ref",
        "threshold",
        "comparison",
        "missing_data",
        "type",
        "window_seconds",
        "evaluation_frequency_seconds",
        "severity",
        "notification_target_refs"
      ],
      "title": "AzureAlarm",
      "type": "object"
    },
    "AzureLogWorkspace": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 63,
          "minLength": 4,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9-]*[a-zA-Z0-9]$",
          "title": "Name",
          "type": "string"
        },
        "resource_refs": {
          "items": {
            "pattern": "^(manifest:[a-zA-Z0-9_.-]{1,512}|/subscriptions/[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}/resourceGroups/[^/\\s]+/providers/[a-zA-Z0-9.]+(/[^/\\s]+/[^/\\s]+)+)$",
            "type": "string"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Resource Refs",
          "type": "array"
        },
        "type": {
          "const": "azure_log_analytics_workspace",
          "title": "Type",
          "type": "string"
        },
        "retention_days": {
          "maximum": 730,
          "minimum": 30,
          "title": "Retention Days",
          "type": "integer"
        },
        "sku": {
          "const": "PerGB2018",
          "title": "Sku",
          "type": "string"
        }
      },
      "required": [
        "name",
        "resource_refs",
        "type",
        "retention_days",
        "sku"
      ],
      "title": "AzureLogWorkspace",
      "type": "object"
    },
    "AzureMetric": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$",
          "title": "Name",
          "type": "string"
        },
        "resource_ref": {
          "pattern": "^(manifest:[a-zA-Z0-9_.-]{1,512}|/subscriptions/[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}/resourceGroups/[^/\\s]+/providers/[a-zA-Z0-9.]+(/[^/\\s]+/[^/\\s]+)+)$",
          "title": "Resource Ref",
          "type": "string"
        },
        "metric_name": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Metric Name",
          "type": "string"
        },
        "type": {
          "const": "azure_monitor_metric",
          "title": "Type",
          "type": "string"
        },
        "namespace": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9.]+/[a-zA-Z0-9/]+$",
          "title": "Namespace",
          "type": "string"
        },
        "aggregation": {
          "enum": [
            "Average",
            "Count",
            "Minimum",
            "Maximum",
            "Total"
          ],
          "title": "Aggregation",
          "type": "string"
        }
      },
      "required": [
        "name",
        "resource_ref",
        "metric_name",
        "type",
        "namespace",
        "aggregation"
      ],
      "title": "AzureMetric",
      "type": "object"
    },
    "BackupConfiguration": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "title": "Enabled",
          "type": "boolean"
        }
      },
      "required": [
