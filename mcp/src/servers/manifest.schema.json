      "type": "object"
    },
    "PolicyConstraintName": {
      "enum": [
        "allowed_regions",
        "max_budget",
        "required_tags",
        "prohibited_resource_types",
        "required_encryption",
        "required_backup"
      ],
      "type": "string"
    },
    "RdsResource": {
