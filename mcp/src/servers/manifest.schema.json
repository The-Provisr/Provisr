  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "provider": {
      "default": "aws",
      "enum": [
        "aws",
        "azure",
        "gcp"
      ],
      "title": "Provider",
      "type": "string"
    },
    "region": {
      "maxLength": 32,
      "minLength": 3,
