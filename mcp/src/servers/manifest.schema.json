        "discriminator": {
          "mapping": {
            "aws_cloudwatch_alarm": "#/$defs/AwsAlarm",
            "aws_cloudwatch_log_group": "#/$defs/AwsLogGroup",
            "aws_cloudwatch_metric": "#/$defs/AwsMetric",
