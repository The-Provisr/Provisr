            "aws_rds": "#/$defs/RdsResource",
            "aws_s3": "#/$defs/S3Resource",
            "azure_log_analytics_workspace": "#/$defs/AzureLogWorkspace",
            "azure_monitor_alarm": "#/$defs/AzureAlarm",
