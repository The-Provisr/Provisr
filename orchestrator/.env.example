# Clerk backend keys (from the Clerk dashboard: API Keys).
# Required when NODE_ENV=production; optional in development where the
# DEV_USER_ID bypass can be used instead.
CLERK_SECRET_KEY=

# Optional comma-separated allow-list of frontend origins accepted as the
# JWT authorized party, e.g. http://localhost:3000,https://app.provisr.io
# CLERK_AUTHORIZED_PARTIES=

# Optional cache TTLs (milliseconds). Defaults to 60000.
# CLERK_TOKEN_CACHE_TTL_MS=60000
# CLERK_MEMBERSHIP_CACHE_TTL_MS=60000

# Internal service base URLs used by the gateway routes. Defaults suit local
# native development; production sets these to the in-cluster service names.
# WORKSPACE_SERVICE_URL=http://localhost:8088
# CLOUD_ACCOUNT_SERVICE_URL=http://localhost:8089

# Shared token the gateway presents on endpoints that require it (cloud
# capabilities). Required unless NODE_ENV=test.
# ORCHESTRATOR_SERVICE_TOKEN=

# Optional upstream request timeout in milliseconds. Defaults to 15000.
# GATEWAY_TIMEOUT_MS=15000
