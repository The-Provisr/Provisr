# Clerk backend keys (from the Clerk dashboard: API Keys).
# Required when NODE_ENV=production; optional in development where the
# DEV_USER_ID bypass can be used instead.
CLERK_SECRET_KEY=

# Optional comma-separated allow-list of frontend origins accepted as the
# JWT authorized party, e.g. http://localhost:3000,https://app.provisr.io
# CLERK_AUTHORIZED_PARTIES=

# Optional cache TTLs (milliseconds). Defaults to 60000.
# CLERK_TOKEN_CACHE_TTL_MS=60000
# CLERK_MEMBERSHIP_CACHE_TTL_MS=60000

# Internal agent dispatch endpoint. The durable planning worker calls this for
# policy, cloud-context, and planning phases after saving a chat turn.
AGENT_API_URL=http://localhost:5000
