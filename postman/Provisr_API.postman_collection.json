    { "key": "workspaceId", "value": "11111111-1111-4111-8111-111111111111" },
    { "key": "sessionId", "value": "22222222-2222-4222-8222-222222222222" },
    { "key": "runId", "value": "33333333-3333-4333-8333-333333333333" },
    { "key": "approvalId", "value": "44444444-4444-4444-8444-444444444444" },
    { "key": "artifactId", "value": "55555555-5555-4555-8555-555555555555" }
